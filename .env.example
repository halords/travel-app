# Server-only credentials. Set both in Vercel's Environment Variables.
# Never prefix credentials with VITE_.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token

# Optional local development: use this instead of cloud credentials.
# TURSO_DATABASE_URL=file:./.local/roam.db
# TURSO_AUTH_TOKEN=
